+        const uint64_t bytes=layer_blob_bytes_[size_t(m.layer)],at=complement_offsets_[m.cold];
+        if(at==kNoComplement || at>complement_bytes_ || bytes>complement_bytes_-at || complement_offsets_[m.hot]!=kNoComplement)continue;
